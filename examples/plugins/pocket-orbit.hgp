{
  "manifest": {
    "api": 1,
    "id": "heartgram.pocket-orbit",
    "name": "Карманная орбита",
    "version": "1.0.0",
    "description": "Добавляет на главный экран кнопку «Орбита» с коротким космическим сообщением."
  },
  "homeChip": {
    "label": "Орбита",
    "icon": "orbit",
    "onTap": {
      "type": "dialog",
      "title": "Связь с орбитой",
      "message": "Сигнал принят. Соседняя звезда говорит, что ты отлично справляешься. Налей себе воды и продолжай полёт. ✦"
    }
  }
}
