[Unit]
Description=HeartGram shared profiles
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=heartgram-profiles
WorkingDirectory=/opt/heartgram-profiles
Environment=HEARTGRAM_BIND=127.0.0.1
Environment=PORT=8315
Environment=HEARTGRAM_PROFILE_DB=/var/lib/heartgram-profiles/profiles.sqlite3
EnvironmentFile=-/etc/heartgram-profiles.env
ExecStart=/usr/bin/python3 -B /opt/heartgram-profiles/server.py
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
